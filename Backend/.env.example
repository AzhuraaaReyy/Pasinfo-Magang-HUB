# =============================================================================
# Backend environment variables — Pasinfo API
# Template for Backend/.env. This file is committed; .env (real values) never is.
#   Local:      Copy-Item .env.example .env   (PowerShell, from Backend/)   or   cp .env.example .env
#   Production: copy to the server env (e.g. ~/pasinfo/backend/.env) and switch the values marked "production".
# REQUIRED before the first start: JWT_SECRET, DB_PASSWORD (same as the Postgres container),
#   SEED_USER_PASSWORD when seeding users, GEMINI_API_KEY (Gemini is the active AI provider below).
# Every other variable has a default in the code; an empty value means "use the default".
# docker-compose.yml passes this whole file to the API container (env_file), so every setting,
# the AI provider included, is changed here and not in docker-compose.yml.
# After a change: docker compose up -d --force-recreate backend   (a plain "docker restart" keeps the old values)
# =============================================================================

# ── Application ───────────────────────────────────────────────────────────────
# development (local) | production (server). docker-compose.yml reads it from here; empty = production.
# This example is set for local development. ON A SERVER SET APP_ENV=production: development mode logs every SQL
# statement (chat text included), opens /api/v1/search/semantic, allows localhost CORS, and does not enforce
# DB_PASSWORD or a real JWT_SECRET. The API prints a [WARN] line at start while it runs in development mode.
APP_ENV=development
# Docker Compose image name for a local build; empty = the registry image. Build architecture: TARGETARCH (empty = amd64).
BACKEND_IMAGE=pasinfo-backend:local
PORT=8080

# Body size limit in MB (default 50 when unset; /chat and /search are limited to 16 KB)
BODY_LIMIT_MB=10

# Client IP behind a reverse proxy (e.g. NGINX). Both must be set to take effect;
# leave empty when the API is reached directly.
# PROXY_HEADER=X-Forwarded-For
# TRUSTED_PROXIES=<IP atau CIDR proxy, dipisah koma>  (isi sesuai topologi deploy)
PROXY_HEADER=
TRUSTED_PROXIES=

# true = the visitor cookie gets Secure and the HSTS header is sent. false locally (http://localhost);
# ON A SERVER SERVED OVER HTTPS SET HTTPS=true (also behind a TLS proxy). With APP_ENV=production and HTTPS not true
# the API prints a [WARN] line at start.
HTTPS=false

# ── JWT ───────────────────────────────────────────────────────────────────────
# REQUIRED — minimum 32 characters — generate with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_32_CHARS

# ── SMTP / Email (Gmail App Password) ─────────────────────────────────────────
# Optional: leave SMTP_PASSWORD empty when email is not used. Older names GMAIL_MAIL / GMAIL_APP_PASSWORD are
# still read when SMTP_USER / SMTP_PASSWORD are empty.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM_NAME=Pasuruan Info
SMTP_FROM_EMAIL=your-email@gmail.com

# ── Database (PostgreSQL / SQLite) ───────────────────────────────────────────
DB_DRIVER=postgres
# Host port 5433 and user pasinfo match docker-compose.yml (host port: LEGACY_POSTGRES_PORT, default 5433).
# Inside the containers Compose overrides DB_HOST and DB_PORT.
DB_HOST=localhost
DB_PORT=5433
DB_USER=pasinfo
DB_PASSWORD=your_postgres_password
# One database holds the vectors of one embedding model. pasinfo_travel_gemini = gemini-embedding-001 (active);
# pasinfo_travel keeps the old Ollama embeddinggemma vectors. Never point another embedding model at a database.
# A new Postgres volume creates this database at its first start.
DB_NAME=pasinfo_travel_gemini
DB_SSLMODE=disable
# Connection pool (default 20 open, 10 idle, 30 minutes); raise DB_MAX_OPEN_CONNS only below PostgreSQL max_connections
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_MIN=30
# SQLite file, used only when DB_DRIVER=sqlite
DB_PATH=/app/data/pasinfo.db

# ── Seeder ────────────────────────────────────────────────────────────────────
# Startup seed is disabled unless explicitly enabled.
RUN_STARTUP_SEED=false
RUN_WILAYAH_SEED=false
RUN_STARTUP_NEWS_FETCH=false
# Password for seeding default users (admin, penulis, editor, member)
SEED_USER_PASSWORD=your_seed_user_password

# ── Travel integrations ───────────────────────────────────────────────────────
# Optional: empty = the travel live endpoints answer with their fallback data.
WEATHER_API_KEY=
GOOGLE_MAPS_SERVER_KEY=
# Road distance and car/motorcycle travel times of the AI assistant's nearest answers (Geoapify Routing API,
# free plan 3,000 credits/day; one nearest answer uses 6). Empty = straight-line distance only, no travel time.
# Times are estimates (traffic=approximated), not live traffic. Key from https://myprojects.geoapify.com
GEOAPIFY_API_KEY=

# ── File uploads ──────────────────────────────────────────────────────────────
# Directory inside container where uploaded images are stored (volume-mounted)
UPLOAD_DIR=/app/uploads/images

# ── AI Assistant: general ─────────────────────────────────────────────────────
# Anonymous chat history retention in days (default 90; 0 disables the purge job)
CHAT_RETENTION_DAYS=90
# Timeout of one LLM call in seconds (default 120)
LLM_HTTP_TIMEOUT_SEC=120
# Maximum simultaneous LLM chat/embedding calls; extra requests wait (default 1)
LLM_MAX_CONCURRENCY=1
# Extra attempts after a provider connection error or 5xx; timeouts, 429 and 4xx are not repeated (default 1, max 3)
LLM_MAX_RETRIES=1

# ── AI Assistant: provider choice ─────────────────────────────────────────────
# Change only these variables, not code.
# Chat: gemini | openai-compatible (9router, OpenRouter, Groq, OpenAI, DeepSeek, ...) | ollama.
#   Changing the chat provider needs no re-embedding.
LLM_PROVIDER=gemini
# Optional chat fallback provider (embeddings never fall back).
LLM_FALLBACK_PROVIDER=
# Embedding provider: gemini. Changing the embedding model needs its own database (see DB_NAME),
# a full re-embedding, and its own EMBED_RELEVANCE_THRESHOLD.
EMBED_PROVIDER=gemini

# ── AI Assistant: Gemini (active provider: chat + embedding) ──────────────────
# Key from https://aistudio.google.com/apikey — only in .env, never in git or chat.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001

# ── AI Assistant: embedding settings ──────────────────────────────────────────
# Must stay 768: faq_knowledge_bases.embedding is vector(768)
EMBED_DIMENSIONS=768
# Pause for corpus embedding: 50 for the Gemini free tier; empty = no pause.
# A provider quota error (429) during a refresh waits about 1 minute and continues.
EMBED_REQUESTS_PER_MINUTE=50
# Similarity at or above which a document is relevant without the LLM judge. It belongs to the
# embedding model: gemini-embedding-001 = 0.66 (calibrated 2026-11-01, Owner); empty = 0.60 (Ollama embeddinggemma).
# Must be above 0.35 and below 1.
EMBED_RELEVANCE_THRESHOLD=0.66
# Similarity a text recommendation (GET /api/v1/recommendations/travel?q=) needs to be shown. It also belongs to the embedding
# model and is lower than the chat threshold because a keyword scores below a question: gemini-embedding-001 = 0.61
# (chosen 2026-11-09 from 17 test queries). The news article search uses the same threshold (2026-11-11: 0.61 also
# fits news, 17 test queries). Empty = 0.61. Must be above 0 and below 1.
RECOMMEND_RELEVANCE_THRESHOLD=0.61
# After that threshold, a text recommendation is shown only when its similarity is at most this much below the first
# card (2026-11-11, Owner option A: 65 test queries, card precision 69% -> 83%). Empty = 0.04. Above 0 and at most 1;
# 1 = no cut.
RECOMMEND_RELATIVE_CUTOFF=0.04

# ── AI Assistant: optional providers (read only when chosen above) ────────────
# openai-compatible chat (LLM_PROVIDER=openai-compatible). A gateway on this machine, from Docker:
#   http://host.docker.internal:<port>/v1
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_CHAT_MODEL=
# openai-compatible embeddings (EMBED_PROVIDER=openai-compatible); EMBED_API_BASE_URL / EMBED_API_KEY default to
# the LLM_API_* values.
EMBED_API_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=
# Ollama (LLM_PROVIDER or EMBED_PROVIDER=ollama), no longer the primary provider. For an API in Docker with
# Ollama on the Windows host: http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=gemma3:4b
OLLAMA_EMBED_MODEL=embeddinggemma
# gemma3 layers on the GPU (empty = Ollama decides)
LLM_OLLAMA_NUM_GPU=

# Examples (keys only in .env or the server env, never in git):
#   Gemini for both (active):  LLM_PROVIDER=gemini  EMBED_PROVIDER=gemini  GEMINI_API_KEY=<key>
#   9router chat + Gemini:     LLM_PROVIDER=openai-compatible  LLM_API_BASE_URL=http://host.docker.internal:<port>/v1
#                              LLM_API_KEY=<key>  LLM_CHAT_MODEL=<model name>  EMBED_PROVIDER=gemini  GEMINI_API_KEY=<key>

# ── Tests only (not read by the API; set in the shell when running the tests) ──────
# PGVECTOR_TEST_DSN="host=localhost port=5433 dbname=pasinfo_travel_gemini user=<user> password=<password> sslmode=disable"
#   runs internal/database/pgvector_integration_test.go (transaction rolled back)
# DB_TEST_POOL is set by internal/database tests themselves.
#
# The AI corpus worker (embedding status, retries) has no extra variables:
# see docs/5 November 2026/TUTORIAL_MENJALANKAN_WORKER.md
