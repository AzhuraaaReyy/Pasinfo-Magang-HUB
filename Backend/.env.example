# =============================================================================
# Backend environment variables — Pasinfo API
# Copy to ~/pasinfo/backend/.env on the Oracle VM
# DO NOT commit this file or .env to the repository
# =============================================================================

# ── Application ───────────────────────────────────────────────────────────────
# Local development (README "Konfigurasi Environment"): APP_ENV=development and HTTPS=false.
APP_ENV=production
PORT=8080

# Body size limit in MB (default 50 when unset; /chat and /search are limited to 16 KB)
BODY_LIMIT_MB=10

# Client IP behind a reverse proxy (e.g. NGINX). Both must be set to take effect;
# leave empty when the API is reached directly.
# PROXY_HEADER=X-Forwarded-For
# TRUSTED_PROXIES=<IP atau CIDR proxy, dipisah koma>  (isi sesuai topologi deploy)
PROXY_HEADER=
TRUSTED_PROXIES=

# Enable HSTS header (set to "true" only when TLS is terminated at this service)
HTTPS=true

# ── JWT ───────────────────────────────────────────────────────────────────────
# REQUIRED — minimum 32 characters — generate with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_32_CHARS

# ── SMTP / Email (Gmail App Password) ─────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM_NAME=Pasuruan Info
SMTP_FROM_EMAIL=your-email@gmail.com

# ── Database (PostgreSQL / SQLite) ───────────────────────────────────────────
DB_DRIVER=postgres
# Values below match the docker-compose.yml defaults (host port 5433, user pasinfo, db pasinfo_travel).
# Inside the containers Compose overrides DB_HOST and DB_PORT.
DB_HOST=localhost
DB_PORT=5433
DB_USER=pasinfo
DB_PASSWORD=your_postgres_password
DB_NAME=pasinfo_travel
DB_SSLMODE=disable
# Connection pool (default 20 open, 10 idle, 30 minutes); raise DB_MAX_OPEN_CONNS only below PostgreSQL max_connections
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_MIN=30
DB_PATH=/app/data/pasinfo.db

# ── Seeder ────────────────────────────────────────────────────────────────────
# Startup seed is disabled unless explicitly enabled.
RUN_STARTUP_SEED=false
RUN_WILAYAH_SEED=false
RUN_STARTUP_NEWS_FETCH=false
# Password for seeding default users (admin, penulis, editor, member)
SEED_USER_PASSWORD=your_seed_user_password

# ── Travel integrations
WEATHER_API_KEY=
GOOGLE_MAPS_SERVER_KEY=

# ── AI Assistant ──────────────────────────────────────────────────────────────
# Anonymous chat history retention in days (default 90; 0 disables the purge job)
CHAT_RETENTION_DAYS=90
# Timeout of one LLM call in seconds (default 120)
LLM_HTTP_TIMEOUT_SEC=120
# Maximum simultaneous LLM chat/embedding calls; extra requests wait (default 1)
LLM_MAX_CONCURRENCY=1
# Extra attempts after a provider connection error or 5xx; timeouts, 429 and 4xx are not repeated (default 1, max 3)
LLM_MAX_RETRIES=1
# Local Ollama only: gemma3 layers on the GPU (leave empty to let Ollama decide; set in docker-compose.override.yml)
LLM_OLLAMA_NUM_GPU=
# ── LLM provider (chosen by env only) ────────────────────────────────────────
# Development uses local Ollama. Production uses an API provider: change only these variables, not code.
# Chat: ollama | gemini | openai-compatible (OpenAI, OpenRouter, Groq, DeepSeek, Mistral, ...).
LLM_PROVIDER=ollama
# Optional chat fallback provider (embeddings never fall back).
LLM_FALLBACK_PROVIDER=
# Embedding provider; empty = same as LLM_PROVIDER. Changing the embedding model re-embeds the corpus once.
EMBED_PROVIDER=

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=gemma3:4b
OLLAMA_EMBED_MODEL=embeddinggemma

GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001

# openai-compatible chat
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_CHAT_MODEL=
# openai-compatible embeddings; EMBED_API_BASE_URL / EMBED_API_KEY default to the LLM_API_* values
EMBED_API_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=
# Must stay 768: faq_knowledge_bases.embedding is vector(768)
EMBED_DIMENSIONS=768
# Optional pause for corpus embedding, e.g. 50 for a Gemini free tier; empty = no pause (local Ollama).
# A provider quota error (429) during a refresh waits about 1 minute and continues.
EMBED_REQUESTS_PER_MINUTE=
# Similarity at or above which a document is relevant without the LLM judge. It depends on the
# embedding model: empty = 0.60 (tuned for Ollama embeddinggemma). Set it with the embedding model,
# gemini-embedding-001: 0.66 (calibrated 2026-11-01, Owner). Must be above 0.35 and below 1.
EMBED_RELEVANCE_THRESHOLD=

# Production examples (keys only in the server env, never in git):
#   Gemini for both:       LLM_PROVIDER=gemini  GEMINI_API_KEY=<key>  EMBED_RELEVANCE_THRESHOLD=0.66
#   OpenAI for both:       LLM_PROVIDER=openai-compatible  LLM_API_BASE_URL=https://api.openai.com/v1
#                          LLM_API_KEY=<key>  LLM_CHAT_MODEL=<chat model>  EMBED_MODEL=text-embedding-3-small
#   OpenAI chat + Gemini:  LLM_PROVIDER=openai-compatible  EMBED_PROVIDER=gemini  (+ LLM_API_* and GEMINI_API_KEY)

# ── File uploads ──────────────────────────────────────────────────────────────
# Directory inside container where uploaded images are stored (volume-mounted)
UPLOAD_DIR=/app/uploads/images
